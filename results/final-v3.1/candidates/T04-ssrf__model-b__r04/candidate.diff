+using System.Net;
+using System.Net.Sockets;
+
 namespace Target;
+
 public static class OutboundUrlPolicy
 {
     public static bool IsAllowed(string value)
-        => Uri.TryCreate(value, UriKind.Absolute, out var uri) && uri.Scheme == Uri.UriSchemeHttps;
+    {
+        if (!Uri.TryCreate(value, UriKind.Absolute, out var uri) ||
+            !string.Equals(uri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase) ||
+            string.IsNullOrEmpty(uri.Host))
+        {
+            return false;
+        }
+
+        if (string.Equals(uri.Host.TrimEnd('.'), "localhost", StringComparison.OrdinalIgnoreCase))
+        {
+            return false;
+        }
+
+        return !IPAddress.TryParse(uri.Host, out var address) || !IsPrivateOrLocal(address);
+    }
+
+    private static bool IsPrivateOrLocal(IPAddress address)
+    {
+        if (address.IsIPv4MappedToIPv6)
+        {
+            address = address.MapToIPv4();
+        }
+
+        if (IPAddress.IsLoopback(address))
+        {
+            return true;
+        }
+
+        var bytes = address.GetAddressBytes();
+
+        if (address.AddressFamily == AddressFamily.InterNetwork)
+        {
+            return bytes[0] == 10 ||
+                   bytes[0] == 127 ||
+                   (bytes[0] == 169 && bytes[1] == 254) ||
+                   (bytes[0] == 172 && bytes[1] >= 16 && bytes[1] <= 31) ||
+                   (bytes[0] == 192 && bytes[1] == 168);
+        }
+
+        return address.AddressFamily == AddressFamily.InterNetworkV6 &&
+               ((bytes[0] == 0xfe && (bytes[1] & 0xc0) == 0x80) ||
+                (bytes[0] & 0xfe) == 0xfc);
+    }
 }
