diff --git a/Target/ArchivePath.cs b/Target/ArchivePath.cs
index 6f69477..d15b86c 100644
--- a/Target/ArchivePath.cs
+++ b/Target/ArchivePath.cs
@@ -2,5 +2,29 @@ namespace Target;
 public static class ArchivePath
 {
     public static string ResolveEntryPath(string extractionRoot, string entryName)
-        => Path.GetFullPath(Path.Combine(extractionRoot, entryName));
+    {
+        if (Path.IsPathRooted(entryName) ||
+            entryName.StartsWith('/') ||
+            entryName.StartsWith('\\') ||
+            (entryName.Length >= 3 &&
+             char.IsLetter(entryName[0]) &&
+             entryName[1] == ':' &&
+             (entryName[2] == '/' || entryName[2] == '\\')) ||
+            entryName.Split(new[] { '/', '\\' }).Any(part => part == ".."))
+        {
+            throw new ArgumentException("Archive entry paths must be relative and must not contain traversal segments.", nameof(entryName));
+        }
+
+        var root = Path.GetFullPath(extractionRoot);
+        var destination = Path.GetFullPath(Path.Combine(root, entryName));
+        var rootPrefix = root.EndsWith(Path.DirectorySeparatorChar) ? root : root + Path.DirectorySeparatorChar;
+        var comparison = OperatingSystem.IsWindows() ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal;
+
+        if (!string.Equals(destination, root, comparison) && !destination.StartsWith(rootPrefix, comparison))
+        {
+            throw new ArgumentException("Archive entry path resolves outside the extraction root.", nameof(entryName));
+        }
+
+        return destination;
+    }
 }
