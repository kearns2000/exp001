{
  "experimentId": "emse-study2-pilot-001",
  "maxParallelism": 1,
  "timeoutMinutes": 10,
  "benchmarkRoot": "benchmarks",
  "resultsRoot": "results",
  "runCodeQl": true,
  "codeQlExecutable": "codeql",
  "codeQlSuite": "codeql/csharp-queries:codeql-suites/csharp-security-extended.qls",
